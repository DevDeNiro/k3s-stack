# =============================================================================
# k3s-stack site configuration
#   cp vps/config.env.example vps/config.env
# Read by install.sh and the scripts of vps/scripts/ (apply-config.sh,
# apply-keycloak.sh, apply-backups.sh, setup-gateway-api.sh, onboard-app.sh...).
# Check it with: ./vps/scripts/apply-config.sh --check
# =============================================================================

# -----------------------------------------------------------------------------
# GitOps: Argo CD auto-discovery and Image Updater
# -----------------------------------------------------------------------------
# Git provider of the application repositories. Current ApplicationSet
# auto-discovery templates support GitHub only.
SCM_PROVIDER="github"

# GitHub organizations holding the application repositories,
# space-separated: one auto-discovery generator per organization, one repository
# token for all of them (export-secrets.sh set-scm-credentials) and one read-only
# image pull token (export-secrets.sh set-registry-credentials). Repository names
# must be unique across the organizations: they name the Argo CD Applications,
# AppProjects and namespaces (<repository>-alpha, <repository>-prod).
# Empty: SCM_ORGANIZATION, the single organization of older configuration files.
SCM_ORGANIZATIONS="my-org other-org"
# SCM_ORGANIZATION="my-org"

# Registry of the application images: <REGISTRY_HOST>/<organization>/<repository>,
# the organization lowercased (registry paths are lowercase).
REGISTRY_HOST="ghcr.io"

# Single organization only: fixed image path, without the repository name. When
# set, it takes precedence over REGISTRY_HOST/<organization>; it is refused with
# several organizations. (ghcr.io/my-org, registry.gitlab.com/my-group)
# REGISTRY_BASE="ghcr.io/my-org"

# -----------------------------------------------------------------------------
# Public exposure: Gateway, certificates, Keycloak routes
# -----------------------------------------------------------------------------
# Email for Let's Encrypt expiry notifications
LETSENCRYPT_EMAIL="admin@example.com"

# Every public hostname served by the Gateway, with the namespace allowed to
# route it: space-separated <hostname>=<namespace> entries. Only the HTTPRoutes
# of that namespace attach to the HTTPS listener of the hostname: a route of any
# other namespace is refused (NotAllowedByListeners), so an application cannot
# take over the hostname, or a path of it, from another one. Several namespaces,
# comma-separated, share a hostname by path (<hostname>=<ns1>,<ns2>).
# The namespaces of an application are <app>-alpha and <app>-prod (onboard-app.sh);
# the hostnames of AUTH_HOSTNAMES belong to security (Keycloak).
# Each hostname gets an HTTPS listener and a Let's Encrypt certificate, and its
# DNS record must point to the VPS. Several domains can be mixed.
GATEWAY_HOSTNAMES="auth.example.com=security app.example.com=my-app-prod alpha.example.com=my-app-alpha"

# Hostnames routed to Keycloak (OIDC endpoints only), each one listed above too,
# with the namespace security
AUTH_HOSTNAMES="auth.example.com"

# Rate limit per client address on the Keycloak OIDC endpoints (/realms):
# requests per second ("10r/s") or per minute ("600r/m"), "off" to disable it.
# The burst is served at once, then requests above the rate get a 429 answer.
# The login assets (/resources) are not limited. Applied by setup-gateway-api.sh.
KEYCLOAK_RATE_LIMIT_RATE="10r/s"
KEYCLOAK_RATE_LIMIT_BURST="20"

# -----------------------------------------------------------------------------
# Keycloak extensions (themes, providers)
# -----------------------------------------------------------------------------
# Images providing Keycloak themes (/themes/<name>/) and/or provider JARs
# (/providers/*.jar), space-separated, copied into Keycloak at every start. Each
# reference needs a tag or a digest, not latest: a tag is pulled once per node,
# so publish a new tag for each change. Image contract: vps/README.md.
# Applied by: sudo ./vps/scripts/apply-keycloak.sh
KEYCLOAK_EXTENSION_IMAGES=""
# KEYCLOAK_EXTENSION_IMAGES="ghcr.io/my-org/my-app-keycloak-theme:1.0.0"

# -----------------------------------------------------------------------------
# Off-site copy of the PostgreSQL dumps (restic, S3-compatible object storage)
# -----------------------------------------------------------------------------
# restic repository: s3:https://<endpoint>/<bucket>/<path>. Empty: the dumps
# stay on the server only. Credentials (object storage keys, restic password):
# sudo ./vps/scripts/setup-secrets.sh set-offsite-backup
# Applied by: sudo ./vps/scripts/apply-backups.sh
OFFSITE_BACKUP_REPOSITORY=""
# OFFSITE_BACKUP_REPOSITORY="s3:https://s3.fr-par.scw.cloud/my-bucket/k3s-stack"

# Region signing the object storage requests. Empty: restic default (us-east-1);
# set it for providers that check it (Scaleway: fr-par, nl-ams or pl-waw).
OFFSITE_BACKUP_REGION=""
