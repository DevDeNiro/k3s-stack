# =============================================================================
# k3s-stack site configuration
#   cp vps/config.env.example vps/config.env
# Read by install.sh, apply-config.sh, setup-gateway-api.sh and onboard-app.sh.
# Check it with: ./vps/scripts/apply-config.sh --check
# =============================================================================

# -----------------------------------------------------------------------------
# GitOps: Argo CD auto-discovery and Image Updater
# -----------------------------------------------------------------------------
# Git provider of the application repositories: github | gitlab
# (repository auto-discovery supports GitHub organizations)
SCM_PROVIDER="github"

# Organization (GitHub) or group (GitLab) holding the application repositories
SCM_ORGANIZATION="my-org"

# Container images base, without the repository name
# (ghcr.io/my-org, registry.gitlab.com/my-group, docker.io/my-user)
REGISTRY_BASE="ghcr.io/my-org"

# -----------------------------------------------------------------------------
# Public exposure: Gateway, certificates, Keycloak routes
# -----------------------------------------------------------------------------
# Email for Let's Encrypt expiry notifications
LETSENCRYPT_EMAIL="admin@example.com"

# Every public hostname served by the Gateway, space-separated. Each one gets an
# HTTPS listener and a Let's Encrypt certificate, and its DNS record must point
# to the VPS. Several domains can be mixed.
GATEWAY_HOSTNAMES="auth.example.com app.example.com alpha.example.com"

# Hostnames routed to Keycloak (OIDC endpoints only), each one listed above too
AUTH_HOSTNAMES="auth.example.com"
