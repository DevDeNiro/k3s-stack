# =============================================================================
# Namespace <app>-alpha: quota and Pod Security level (scripts/onboard-app.sh)
# =============================================================================
QUOTA_REQUESTS_CPU="1"
QUOTA_REQUESTS_MEMORY="1Gi"
# A rolling update runs the old and the new pod together: the limits must hold
# twice the largest pod (JVM applications commonly use a 1.5 CPU limit)
QUOTA_LIMITS_CPU="4"
QUOTA_LIMITS_MEMORY="2Gi"
QUOTA_PODS="10"

# baseline: more permissive than prod, convenient for debugging
POD_SECURITY_ENFORCE="baseline"
