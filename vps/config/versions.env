# =============================================================================
# Versions installed by vps/install.sh and local/install.sh, validated together.
# Each one can be overridden from the environment: sudo K3S_VERSION=... ./vps/install.sh
#
# An installed cluster keeps its versions: K3s is upgraded with
# scripts/k3s-maintenance.sh, everything else follows a reinstallation.
# Checked against the charts with: helm template ... --kube-version <K3s version>
# =============================================================================

# K3s: the local k3d cluster runs the same release (rancher/k3s image).
# K3s ships the Gateway API CRDs (gateway-api-crd component: v1.6.3 in v1.37.2).
K3S_VERSION="${K3S_VERSION:-v1.37.2+k3s1}"

# NGINX Gateway Fabric: 2.8.1 is tested with Gateway API v1.6.3
# (config/crd/gateway-api/standard/kustomization.yaml of the NGF release)
NGINX_GATEWAY_FABRIC_VERSION="${NGINX_GATEWAY_FABRIC_VERSION:-2.8.1}"
CERT_MANAGER_VERSION="${CERT_MANAGER_VERSION:-v1.21.3}"

# Helm charts (the PostgreSQL image itself is pinned in values/postgresql-image.yaml)
POSTGRESQL_CHART_VERSION="${POSTGRESQL_CHART_VERSION:-18.12.18}"
SEALED_SECRETS_CHART_VERSION="${SEALED_SECRETS_CHART_VERSION:-2.22.0}"
ARGOCD_CHART_VERSION="${ARGOCD_CHART_VERSION:-10.17.1}"
ARGOCD_IMAGE_UPDATER_CHART_VERSION="${ARGOCD_IMAGE_UPDATER_CHART_VERSION:-1.4.2}"
PROMETHEUS_CHART_VERSION="${PROMETHEUS_CHART_VERSION:-29.47.0}"
GRAFANA_CHART_VERSION="${GRAFANA_CHART_VERSION:-10.5.15}"
LOKI_CHART_VERSION="${LOKI_CHART_VERSION:-7.5.0}"
PROMTAIL_CHART_VERSION="${PROMTAIL_CHART_VERSION:-6.17.1}"

# Off-site copy of the PostgreSQL dumps (docker.io/restic/restic, scripts/apply-backups.sh).
# Repository format 2: restic 0.14 or later reads it (restore from any workstation).
RESTIC_VERSION="${RESTIC_VERSION:-0.19.1}"
